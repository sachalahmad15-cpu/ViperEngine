package com.viperengine

import android.content.Intent
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.widget.Button
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.ContextCompat

class MainActivity : AppCompatActivity() {
    private val OVERLAY_PERMISSION_CODE = 1001
    private val MEDIA_PROJECTION_CODE = 1002

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        findViewById<Button>(R.id.btnStart).setOnClickListener { requestAllPermissions() }
        findViewById<Button>(R.id.btnCapture).setOnClickListener { requestScreenCapture() }
    }

    private fun requestAllPermissions() {
        if (!Settings.canDrawOverlays(this)) {
            startActivityForResult(
                Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:$packageName")),
                OVERLAY_PERMISSION_CODE
            )
            Toast.makeText(this, "Grant overlay permission", Toast.LENGTH_LONG).show()
            return
        }
        val service = "$packageName/.GameAccessibilityService"
        val enabled = Settings.Secure.getString(contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES)
        if (enabled == null || !enabled.split(":").any { it.equals(service, true) }) {
            Toast.makeText(this, "Enable Viper Engine in Accessibility Settings", Toast.LENGTH_LONG).show()
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
            return
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            requestPermissions(arrayOf(android.Manifest.permission.POST_NOTIFICATIONS), 1003)
        }
        startForegroundService(Intent(this, OverlayService::class.java))
        Toast.makeText(this, "Viper Engine started — open 8 Ball Pool", Toast.LENGTH_SHORT).show()
    }

    private fun requestScreenCapture() {
        val pm = getSystemService(MEDIA_PROJECTION_SERVICE) as android.media.projection.MediaProjectionManager
        startActivityForResult(pm.createScreenCaptureIntent(), MEDIA_PROJECTION_CODE)
    }

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        when (requestCode) {
            OVERLAY_PERMISSION_CODE -> { if (Settings.canDrawOverlays(this)) requestAllPermissions() }
            MEDIA_PROJECTION_CODE -> {
                if (resultCode == RESULT_OK && data != null) {
                    Intent(this, OverlayService::class.java).apply {
                        putExtra("mediaProjectionResultCode", resultCode)
                        putExtra("mediaProjectionData", data)
                    }.also { startService(it) }
                }
            }
        }
    }
}
